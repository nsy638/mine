    overflow: hidden;        /* 둥근 영역 밖은 잘라냄 */
    margin: auto;           /* 중앙 정렬 */
  }

  .rectangle-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;      /* 이미지 비율 유지 + 중앙 크롭 */
    display: block;
  }

  /* aspect-ratio 미지원 브라우저 대응 */
  @supports not (aspect-ratio: 1 / 2) {
    .rectangle-img {
      position: relative;
      padding-top: 200%;    /* 🛠️ 1:2 비율 유지를 위해 200%로 변경 (너비의 2배 세로폭) */
    }
    .rectangle-img img {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
    }
  }
</style>
